# すべて任意。何も設定しなくてもアプリは動く。
# VOICEVOX で音声にして毎朝聞く手順は docs/VOICEVOX.md にまとめてある。

# ── 台本を Claude に書かせる ────────────────────────────────
# 未設定でもテンプレート生成で番組は作られる。
# 設定すると英語記事が日本語化され、ニュース同士のつながりも説明される。
ANTHROPIC_API_KEY=

# ── 音声ファイルを作る（ポッドキャストアプリで聞くために必要）──
# どちらか片方でよい。両方あれば VOICEVOX が優先される。

# VOICEVOX：鍵不要。自分で engine を立てる。
# docker compose を使う場合は自動で設定されるので、ここは空のままでよい。
VOICEVOX_URL=
VOICEVOX_SPEAKER=3

# docker compose 用。イメージが見つからない場合に差し替える。
# VOICEVOX_IMAGE=voicevox/voicevox_engine:cpu-ubuntu20.04-latest
# VOICEVOX_CPUS=2

# Google Cloud Text-to-Speech：立ち上げ不要。従量課金。
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=ja-JP-Neural2-B

# 読み上げ速度（1.0 が等速）。ニュースは 1.2 前後が聞きやすい。
TTS_SPEED=1.0

# 音声生成の再試行回数。engine の起動待ちを吸収する。
TTS_RETRIES=3

# ── 毎朝の自動生成 ──────────────────────────────────────────
# 5 時に聞き始めたいなら、少し前に作っておく。既定は 4:30。
DAILY_HOUR=4
DAILY_MINUTE=30
DAILY_TIMEZONE=Asia/Tokyo

# false にすると自動生成を止める
DAILY_ENABLED=true

# 予定時刻に機械が止まっていた場合、次の起動時に作り直す
DAILY_CATCH_UP=true

# 番組の長さ（5 / 10 / 15）
EPISODE_MINUTES=10

# ── 配信 ────────────────────────────────────────────────────
# ポッドキャストRSSに書く絶対URL。
# 同じ家のスマホから聞くなら http://192.168.x.x:3000 のように書く。
PUBLIC_BASE_URL=

# 音声と台本の保存先。既定は .techcast-data/
TECHCAST_DATA_DIR=

# 番組名（ポッドキャストアプリに表示される）
PODCAST_TITLE=
PODCAST_AUTHOR=

# /api/cron を外から叩けるようにする場合の保護。公開環境では必ず設定すること。
CRON_SECRET=

# 待ち受けポート
PORT=3000

# docker compose でホスト側に出すポート
APP_PORT=3000
VOICEVOX_PORT=50021
