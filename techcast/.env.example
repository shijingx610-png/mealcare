# すべて任意。何も設定しなくてもアプリは動く。

# ── 台本を Claude に書かせる ────────────────────────────────
# 未設定でもテンプレート生成で番組は作られる。
# 設定すると英語記事が日本語化され、ニュース同士のつながりも説明される。
ANTHROPIC_API_KEY=

# ── 音声ファイルを作る（ポッドキャストアプリで聞くために必要）──
# どちらか片方でよい。両方あれば VOICEVOX が優先される。

# VOICEVOX：鍵不要。自分で engine を立てる。
#   docker run -d -p 50021:50021 voicevox/voicevox_engine:cpu-latest
VOICEVOX_URL=
VOICEVOX_SPEAKER=3

# Google Cloud Text-to-Speech：立ち上げ不要。従量課金。
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=ja-JP-Neural2-B

# 読み上げ速度（1.0 が等速）
TTS_SPEED=1.0

# ── 日次生成と配信 ──────────────────────────────────────────
# 番組の長さ（5 / 10 / 15）
EPISODE_MINUTES=10

# /api/cron を保護する。公開環境では必ず設定すること。
CRON_SECRET=

# ポッドキャストRSSに書く絶対URL。未設定ならリクエストから組み立てる。
PUBLIC_BASE_URL=

# 音声と台本の保存先。既定は .techcast-data/
TECHCAST_DATA_DIR=

# 番組名（ポッドキャストアプリに表示される）
PODCAST_TITLE=
PODCAST_AUTHOR=
